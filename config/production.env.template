# Valifi Kingdom Production Environment Variables
# ------------------------------------------------
# Copy this file to `.env.production` and replace every placeholder with
# the real credential before deploying.

# ------------ Application ------------
NODE_ENV=production
# Use port 5000 when running inside this workspace (other ports are blocked)
PORT=5000
NEXT_PUBLIC_APP_URL=https://valifi.com
NEXT_PUBLIC_API_URL=https://valifi.com/api

# ------------ Database ------------
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/valifi_production
AWS_RDS_HOST=<your-rds-endpoint.rds.amazonaws.com>
AWS_RDS_PORT=5432
AWS_RDS_DATABASE=valifi_fintech
AWS_RDS_USERNAME=<aws_rds_username>
AWS_RDS_PASSWORD=<aws_rds_password>
AWS_RDS_SSL=true
AWS_RDS_MAX_CONNECTIONS=20
AWS_RDS_CONNECTION_TIMEOUT=30000
TURSO_DATABASE_URL=libsql://<turso-db>.turso.io
TURSO_AUTH_TOKEN=<turso_auth_token>

# ------------ Security ------------
JWT_SECRET=<64+_char_jwt_secret>
JWT_REFRESH_SECRET=<64+_char_jwt_refresh_secret>
ENCRYPTION_KEY=<32_char_encryption_key>
SESSION_SECRET=<session_secret>

# ------------ Market Data APIs ------------
POLYGON_API_KEY=<polygon_api_key>
ALPHA_VANTAGE_API_KEY=<alpha_vantage_api_key>
IEX_CLOUD_API_KEY=<iex_cloud_api_key>

# ------------ Trading/Broker APIs ------------
ALPACA_API_KEY=<alpaca_api_key>
ALPACA_API_SECRET=<alpaca_api_secret>
ALPACA_PAPER_TRADING=false
ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets/v2
IB_GATEWAY_HOST=localhost
IB_GATEWAY_PORT=7497
IB_CLIENT_ID=1
IB_ENCRYPTION_KEY=<32_byte_hex_key>

# ------------ Payment Processing ------------
STRIPE_SECRET_KEY=<stripe_live_secret_key>
STRIPE_PUBLISHABLE_KEY=<stripe_live_publishable_key>
STRIPE_WEBHOOK_SECRET=<stripe_webhook_secret>
PAYPAL_CLIENT_ID=<paypal_client_id>
PAYPAL_CLIENT_SECRET=<paypal_client_secret>

# ------------ Banking / KYC ------------
PLAID_CLIENT_ID=<plaid_client_id>
PLAID_SECRET=<plaid_secret>
PLAID_ENV=production
JUMIO_API_TOKEN=<jumio_api_token>
JUMIO_API_SECRET=<jumio_api_secret>
JUMIO_BASE_URL=https://netverify.com/api/v4
CHAINALYSIS_API_KEY=<chainalysis_api_key>
OFAC_API_KEY=<ofac_api_key>

# ------------ ArmorWallet Integration ------------
ARMOR_WALLET_API_URL=https://api.armorwallet.com/v1
ARMOR_WALLET_API_KEY=<armor_wallet_api_key>
ARMOR_WALLET_API_SECRET=<armor_wallet_api_secret>
ARMOR_WALLET_ENCRYPTION_KEY=<32_byte_hex_key>

# ------------ Crypto / Blockchain ------------
BITCOIN_NODE_URL=https://bitcoin-node.valifi.com
ETHEREUM_NODE_URL=https://ethereum-node.valifi.com
BINANCE_API_KEY=<binance_api_key>
BINANCE_SECRET_KEY=<binance_secret_key>

# ------------ Email / Notifications ------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<sendgrid_api_key>
FROM_EMAIL=noreply@valifi.com

# ------------ Monitoring ------------
SENTRY_DSN=<sentry_dsn>
DATADOG_API_KEY=<datadog_api_key>

# ------------ AWS / Cloud ------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<aws_secret_access_key>
AWS_S3_BUCKET=valifi-production-assets

# ------------ Security & Rate Limiting ------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=https://valifi.com

# ------------ Feature Flags ------------
ENABLE_TRADING_BOTS=true
ENABLE_REAL_MONEY=false
ENABLE_KYC_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=true

# ------------ Compliance ------------
MAX_DAILY_TRADING_VOLUME=50000
MAX_POSITION_SIZE=10000
REQUIRE_KYC_FOR_TRADING=true
AML_REPORTING_THRESHOLD=10000

# Ensure no placeholder values remain before deployment.
